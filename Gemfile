source "https://rubygems.org"

# GitHub Pages — builds the site server-side with a pinned, supported
# Jekyll + plugin set. Run `bundle exec jekyll serve` locally if you install
# a modern Ruby (3.x).
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end
